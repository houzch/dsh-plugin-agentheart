{
  "name": "@agentheart/dsh-plugin-agentheart",
  "version": "0.1.0",
  "description": "AgentHeart 调度内核的 DeepSeek Harness 嵌入式插件（Sidecar + Cordis）：任务 / 定时 / 队列 / 循环 / 自动化规则",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "agentheart",
    "scheduler"
  ],
  "license": "MIT",
  "author": "houzch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houzch/dsh-plugin-agentheart.git"
  },
  "homepage": "https://github.com/houzch/dsh-plugin-agentheart#readme",
  "bugs": {
    "url": "https://github.com/houzch/dsh-plugin-agentheart/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \"test-build/*.test.js\"",
    "pack:platforms": "node scripts/build-platform-packages.mjs",
    "clean": "node -e \"const fs=require('node:fs');for(const d of ['lib','test-build'])fs.rmSync(d,{recursive:true,force:true})\"",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "optionalDependencies": {
    "@agentheart/agentheartd-win32-x64": "0.1.0",
    "@agentheart/agentheartd-darwin-x64": "0.1.0",
    "@agentheart/agentheartd-darwin-arm64": "0.1.0",
    "@agentheart/agentheartd-linux-x64": "0.1.0",
    "@agentheart/agentheartd-linux-arm64": "0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
